{
  "TokenSettings": {
    "Secret": "%TOKEN_SECRET%"
  },
  "ConnectionStrings": {
    "DefaultConnection": "server=%DATABASE_HOST%;port=%DATABASE_PORT%;user=%DATABASE_USER%;password=%DATABASE_PASSWORD%;database=%DATABASE_SCHEMA%;SslMode=%DATABASE_SSL_MODE%"
  },
  "Stripe": {
    "SecretKey": "%STRIPE_SECRET_KEY%",
    "WebhookSecret": "%STRIPE_WEBHOOK_SECRET%",
    "Prices": {
      "PremiumMonthly": "%STRIPE_PRICE_PREMIUM_MONTHLY%",
      "EnterpriseMonthly": "%STRIPE_PRICE_ENTERPRISE_MONTHLY%"
    }
  },
  "Frontend": {
    "BaseUrl": "%FRONTEND_BASE_URL%",
    "RegisterPath": "%FRONTEND_REGISTER_PATH%",
    "RegisterCompletePath": "%FRONTEND_REGISTER_COMPLETE_PATH%"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
