<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <InvariantGlobalization>false</InvariantGlobalization> <!-- Changed to false -->
        <LangVersion>14</LangVersion>
    </PropertyGroup>

    <ItemGroup>
        <!-- EntityFrameworkCore Database Persistence related packages -->
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.8"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.8"/>

        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.8"/>
        <!-- MySQL Database Persistence related packages -->
        <PackageReference Include="MySql.EntityFrameworkCore" Version="10.0.7"/>
        <!-- Naming convention conversion related packages -->
        <PackageReference Include="Humanizer" Version="3.0.10"/>
        <!-- OpenAPI documentation related packages -->
        <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.0"/>
        <PackageReference Include="Swashbuckle.AspNetCore.Annotations" Version="10.2.0"/>
        <!-- BCrypt Encription related packages -->
        <PackageReference Include="BCrypt.Net-Next" Version="4.2.0"/>
        <!-- JSON Web Token related packages -->
        <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.18.0"/>
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.8"/>
        <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.18.0"/>
        <!-- Mediator pattern related packages -->
        <PackageReference Include="Cortex.Mediator" Version="3.1.2"/>
    </ItemGroup>

    <ItemGroup>
        <Folder Include="Inventory\Application\Internal\QueryServices\" />
        <Folder Include="Inventory\Domain\Model\Entities\" />
        <Folder Include="Inventory\Domain\Model\Errors\" />
        <Folder Include="Inventory\Domain\Model\Events\" />
        <Folder Include="Inventory\Infrastructure\Persistence\EntityFrameworkCore\Configuration\Extensions\" />
        <Folder Include="Inventory\Infrastructure\Persistence\EntityFrameworkCore\Repositories\" />
        <Folder Include="Inventory\Interfaces\Acl\" />
        <Folder Include="Inventory\Interfaces\Rest\Resources\" />
        <Folder Include="Inventory\Interfaces\Rest\Transform\" />
        <Folder Include="Inventory\Resources\" />
        <Folder Include="Iot\Domain\Model\Entities\" />
        <Folder Include="Iot\Domain\Model\Events\" />
        <Folder Include="Operations\Domain\Model\Errors\" />
        <Folder Include="Operations\Resources\" />
        <Folder Include="Profiles\Application\" />
        <Folder Include="Profiles\Infrastructure\" />
        <Folder Include="Profiles\Interfaces\" />
        <Folder Include="Profiles\Resources\" />
        <Folder Include="Shared\Application\"/>
        <Folder Include="Shared\Infrastructure\"/>
        <Folder Include="Shared\Interfaces\"/>
        <Folder Include="Shared\Resources\"/>
        <Folder Include="Spm\Application\" />
        <Folder Include="Spm\Infrastructure\" />
        <Folder Include="Spm\Interfaces\" />
        <Folder Include="Spm\Resources\" />
        
    </ItemGroup>

</Project>
